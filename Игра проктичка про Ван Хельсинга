import random

class Monster:
    def __init__(self, name, hp, dmg):
        self.__name = name
        self.__hp = hp
        self.__dmg = dmg

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def get_dmg(self):
        return self.__dmg

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def is_alive(self):
        return self.__hp > 0

    def show_status(self):
        print(f"[{self.__name}] HP: {self.__hp}")

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получает {damage} урона. HP: {self.get_hp()}")

    def attack_hunter(self, hunter):
        hunter.set_hp(hunter.get_hp() - self.__dmg)
        print(f"{self.get_name()} атакует охотника! Урон: {self.__dmg}")

class Zombie(Monster):
    def __init__(self, name):
        super().__init__(name, 120, 10)

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} теряет конечность! Получено: {damage}. HP: {self.get_hp()}")

class Vampire(Monster):
    def __init__(self, name):
        super().__init__(name, 80, 15)

    def take_damage(self, damage):
        absorbed = 5
        actual_damage = max(0, damage - absorbed)
        self.set_hp(self.get_hp() - actual_damage)
        print(f"{self.get_name()} поглощает {absorbed} урона! Получено: {actual_damage}. HP: {self.get_hp()}")

class Ghost(Monster):
    def __init__(self, name):
        super().__init__(name, 60, 20)

    def take_damage(self, damage):
        if random.random() < 0.3:
            print(f"{self.get_name()} уклоняется от атаки! HP: {self.get_hp()}")
        else:
            self.set_hp(self.get_hp() - damage)
            print(f"{self.get_name()} получает {damage} урона. HP: {self.get_hp()}")

class Werewolf(Monster):
    def __init__(self, name):
        super().__init__(name, 100, 25)
        self.__transformed = False

    def take_damage(self, damage):
        self.set_hp(self.get_hp() - damage)
        print(f"{self.get_name()} получает {damage} урона. HP: {self.get_hp()}")
        if self.get_hp() < 50 and not self.__transformed:
            self.__transformed = True
            print(f"{self.get_name()} трансформируется в свою истинную форму! Сила увеличивается!")

class Weapon:
    def __init__(self, name):
        self.__name = name

    def get_name(self):
        return self.__name

    def use(self, monster):
        pass

class SilverSword(Weapon):
    def __init__(self):
        super().__init__("Серебряный меч")

    def use(self, monster):
        damage = 30
        print(f"\nВан Хельсинг взмахивает Серебряным мечом!")
        monster.take_damage(damage)

class HolyWater(Weapon):
    def __init__(self):
        super().__init__("Святая вода")

    def use(self, monster):
        damage = 20
        print(f"\nВан Хельсинг брызгает Святой водой!")
        monster.take_damage(damage)

class CrossbowBolt(Weapon):
    def __init__(self):
        super().__init__("Арбалет с болтом")

    def use(self, monster):
        damage = 25
        print(f"\nВан Хельсинг стреляет из арбалета!")
        monster.take_damage(damage)

class Hunter:
    def __init__(self, name):
        self.__name = name
        self.__hp = 100
        self.__weapons = []
        self.__current_weapon = 0

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0
        else:
            self.__hp = value

    def add_weapon(self, weapon):
        self.__weapons.append(weapon)
        print(f"Оружие '{weapon.get_name()}' добавлено в арсенал!")

    def show_inventory(self):
        if not self.__weapons:
            print("Инвентарь пуст!")
            return
        print("\n=== Инвентарь охотника ===")
        for i, weapon in enumerate(self.__weapons, 1):
            print(f"{i}. {weapon.get_name()}")
        print("=" * 27)

    def auto_attack(self, monster):
        if not self.__weapons:
            print("Нет оружия!")
            return False
        weapon = self.__weapons[self.__current_weapon]
        print(f"\n{self.__name} атакует {monster.get_name()} оружием '{weapon.get_name()}'!")
        weapon.use(monster)

        self.__current_weapon = (self.__current_weapon + 1) % len(self.__weapons)
        return True

    def is_alive(self):
        return self.__hp > 0

    def show_status(self):
        print(f"\n[{self.__name}] HP: {self.__hp}")


def run_game():
    print("=" * 60)
    print("ДОБРО ПОЖАЛОВАТЬ В СИМУЛЯТОР ОХОТЫ НА НЕЧИСТЬ!")
    print("=" * 60)

    hunter = Hunter("Ван Хельсинг")
    print(f"\nОхотник {hunter.get_name()} готов к бою!")

    hunter.add_weapon(SilverSword())
    hunter.add_weapon(HolyWater())
    hunter.add_weapon(CrossbowBolt())
    hunter.show_inventory()

    monsters = [
        Zombie("Зомби-страж"),
        Vampire("Граф Дракула"),
        Ghost("Призрак замка"),
        Werewolf("Оборотень")]

    print("\n" + "=" * 60)
    print("МОНСТРЫ ПРИБЛИЖАЮТСЯ!")
    print("=" * 60)
    for monster in monsters:
        monster.show_status()

    print("\n" + "=" * 60)
    print("БОЙ НАЧИНАЕТСЯ!")
    print("=" * 60)

    round_number = 1
    current_monster_index = 0

    while hunter.is_alive() and current_monster_index < len(monsters):
        monster = monsters[current_monster_index]

        print(f"\n{'=' * 60}")
        print(f"РАУНД {round_number} - Бой с {monster.get_name()}")
        print(f"{'=' * 60}")

        hunter.show_status()
        monster.show_status()

        hunter.auto_attack(monster)  # Оружие по кругу

        if not monster.is_alive():
            print(f"\n{monster.get_name()} повержен! Победа!")
            current_monster_index += 1
            round_number += 1
            continue

        print(f"\n{monster.get_name()} контратакует!")
        monster.attack_hunter(hunter)

        if not hunter.is_alive():
            print(f"\n{monster.get_name()} победил охотника!")
            break

        round_number += 1

        print(f"\n--- Статус после раунда {round_number - 1} ---")
        hunter.show_status()
        monster.show_status()

    print("\n" + "=" * 60)
    print("ИТОГ БИТВЫ")
    print("=" * 60)

    if hunter.is_alive() and current_monster_index == len(monsters):
        print(f"ПОБЕДА! {hunter.get_name()} зачистил замок от всей нечисти!")
        print(f"Осталось здоровья: {hunter.get_hp()}")
    elif not hunter.is_alive():
        print("ПОРАЖЕНИЕ! Монстры одолели охотника...")
        print(f"Уничтожено монстров: {current_monster_index} из {len(monsters)}")
    else:
        print("Бой прерван... Судьба замка остаётся неизвестной.")


run_game()
