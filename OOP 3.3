# ЭТАП 1 - Инкапсуляция: Создаём монстра
import random

#монстр родитель

class Monster:

    def __init__(self, name, hp, dmg):

        self.__name = name

        self.__hp = hp

        self.__dmg = dmg

    def get_hp(self):

        return self.__hp

    def get_dmg(self):

        return self.__dmg

    def get_name(self):

        return self.__name

    # Проверка на минус хп

    def set_hp(self, value):

        if value < 0:

            self.__hp = 0

    # Проверка на жив/мертв

    def is_alive(self):

        return self.__hp > 0

    def show_status(self):

        print(f'Name: {self.__name}')

        print(f'HP: {self.__hp}')

    def take_damage(self, damage):

        self.__hp -= damage

    def attack_hunter(self, hunter):

        hunter = self.__hp - self.__dmg

#дочерние классы

# Зомби ничего не делает

# ЭТАП 2 - Наследование: Армия нечисти
class Zombie(Monster):

    def __init__(self, name):

        super().__init__(name, 120, 10)

    def take_damage(self, damage):

        self.set_hp(self.get_hp() - damage)

        print(f"Ого! Зомби теряет конечность! Получено {damage}, Осталось: {self.get_hp()}хп")

# Вампир поглощает 5 хп от получаемого урона

class Vampire(Monster):

    def __init__(self, name):

        super().__init__(name, 80, 15)

    def take_damage(self, damage):

        self.set_hp(self.get_hp() - damage)

        print(f"Дракула поглащает 5 урона! получено: {damage}, осталось: {self.get_hp()}хп")

# Призрак может в 30% уклонится от удара

class Ghost(Monster):

    def __init__(self, name):

        super().__init__(name, 60, 20)

    def take_damage(self, damage):

        if random.random() < 0.3:

            self.set_hp(self.get_hp() - damage)

            print(f"Призрак получает урон {damage}, Осталось {self.get_hp()}хп")

        else:

            print("призрак увернулся!")

# превращение возможно если у оборотня больше 50 хп

class Werewolf(Monster):

    def __init__(self, name):

        super().__init__(name, 100, 25)

    def take_damage(self, damage):

        self.set_hp(self.get_hp() - damage)

        print(f"Оборотень получает урон {damage}, у него осталось: {self.get_hp()} хп")

        if self.__hp < 50:

            print("Оборотень трансформируется!")

