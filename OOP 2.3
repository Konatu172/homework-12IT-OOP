class Monster:
    def __init__(self, name, power, hp):

        self.name = name

        self.power = power

        self.hp = hp

    def mutate(self):

        self.power += 5

        print(f"{self.name} мутирует в бою! Сила Дракулы увеличена!")

        print(f"⚔️: {self.power}")

    def test(self):

        self.hp += 10

        print(f"{self.name} пьёт кровь жертвы! Здоровье Дракулы восстановлено!")

        print(f"❤️: {self.hp}")

m = Monster("Дракула", 15, 90)

m.mutate()

m.test()
